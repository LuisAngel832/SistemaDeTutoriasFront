# Variables para el build de produccion (vite build).
# Render tambien puede inyectar estas variables; este archivo sirve como valor
# por defecto y queda versionado (NO contiene secretos, solo la URL publica).

# URL absoluta del backend. En produccion NO existe el proxy de Vite, por lo que
# las llamadas a la API deben apuntar directamente al backend desplegado.
# Requiere que el backend tenga CORS habilitado para el origen del frontend.
VITE_API_URL=https://tutoriasbe.onrender.com
