# Copia este archivo como .env y ajusta los valores segun tu entorno.

# URL del backend. Dejar vacia para usar el proxy de Vite que reenvia a
# http://localhost:8080 (ver vite.config.js). Definir una URL absoluta solo
# cuando quieras saltarte el proxy (ej. apuntar a un backend desplegado).
VITE_API_URL=

# URL del backend a la que Vite hara proxy en desarrollo. Solo aplica si
# VITE_API_URL queda vacio. Por defecto: http://localhost:8080
VITE_BACKEND_URL=http://localhost:8080

# Para PRODUCCION (Render Static Site) no hay proxy de Vite: la URL absoluta del
# backend se define en .env.production (ya versionado) o como env var en Render.
# Ver render.yaml y la seccion "Despliegue en Render" del README.
