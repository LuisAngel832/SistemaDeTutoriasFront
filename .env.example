# Copia este archivo como .env y ajusta los valores segun tu entorno.

# URL del backend. Dejar vacia para usar el proxy de Vite (ver vite.config.js). Definir una
# URL absoluta solo cuando quieras saltarte el proxy.
VITE_API_URL=

# URL del backend a la que Vite hara proxy en desarrollo. Solo aplica si VITE_API_URL queda
# vacio. Por defecto: https://tutoriasbe.onrender.com (usa http://localhost:8080 para un
# backend local).
VITE_BACKEND_URL=https://tutoriasbe.onrender.com

# Para PRODUCCION (Render Static Site) no hay proxy de Vite: la URL absoluta del
# backend se define en .env.production (ya versionado) o como env var en Render.
# Ver render.yaml y la seccion "Despliegue en Render" del README.
